{
  "name": "edupilo-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:check": "node --env-file-if-exists=../.env scripts/check-database.mjs",
    "auth:check": "node --env-file-if-exists=../.env scripts/check-auth-env.mjs",
    "ai:check": "node --env-file-if-exists=../.env scripts/check-ai-env.mjs",
    "predev": "npm run db:check && npm run auth:check",
    "dev": "node --env-file-if-exists=../.env node_modules/next/dist/bin/next dev",
    "build": "next build",
    "prestart": "npm run db:check && npm run auth:check",
    "start": "node --env-file-if-exists=../.env node_modules/next/dist/bin/next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "jose": "^6.2.17",
    "mongoose": "^9.11.4",
    "next": "16.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}

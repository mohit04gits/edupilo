# ElevenLabs API credentials for the internal Phase 0 narration evaluation.
# Copy this file to .env and replace the placeholder locally.
# Never commit or share the real API key.
ELEVENLABS_API_KEY=replace_with_your_elevenlabs_api_key

# MongoDB Atlas connection for application metadata.
# Replace the password only in the local .env file. URL-encode special characters.
MONGODB_URI=mongodb+srv://REPLACE_WITH_DB_USER:REPLACE_WITH_URL_ENCODED_PASSWORD@REPLACE_WITH_CLUSTER_HOST/?retryWrites=true&w=majority
MONGODB_DB_NAME=edupilo

# Authentication. Generate a unique random value of at least 32 characters.
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS

# Server-only AI planning providers. Pin exact reviewed model identifiers locally.
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=replace_with_approved_gemini_model
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=replace_with_approved_groq_model

CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_api_token
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast